    "endpoint-message": {
      "excerpts": [
        {
          "line": 2710,
          "text": " * @field process Describes the process that took the action."
        },
        {
          "line": 2711,
          "text": " * @field seq_num Per-client, per-event-type sequence number that can be"
        },
        {
          "line": 2712,
          "text": " *        inspected to detect whether the kernel had to drop events for this"
        },
        {
          "line": 2713,
          "text": " *        client.  When no events are dropped for this client, seq_num"
        },
        {
          "line": 2714,
          "text": " *        increments by 1 for every message of that event type.  When events"
        },
        {
          "line": 2715,
          "text": " *        have been dropped, the difference between the last seen sequence"
        },
        {
          "line": 2716,
          "text": " *        number of that event type plus 1 and seq_num of the received message"
        },
        {
          "line": 2717,
          "text": " *        indicates the number of events that had to be dropped."
        },
        {
          "line": 2718,
          "text": " *        Dropped events generally indicate that more events were generated in"
        },
        {
          "line": 2719,
          "text": " *        the kernel than the client was able to handle."
        },
        {
          "line": 2720,
          "text": " *        @see global_seq_num"
        },
        {
          "line": 2721,
          "text": " * @field action_type Indicates if the action field is an auth or notify action."
        },
        {
          "line": 2722,
          "text": " * @field action For auth events, contains the opaque auth ID that must be"
        },
        {
          "line": 2723,
          "text": " *        supplied when responding to the event.  For notify events, describes"
        },
        {
          "line": 2724,
          "text": " *        the result of the action."
        },
        {
          "line": 2731,
          "text": " *        csops(CS_OPS_MARKINVALID)."
        },
        {
          "line": 2732,
          "text": " * @field global_seq_num Per-client sequence number that can be inspected to"
        },
        {
          "line": 2733,
          "text": " *        detect whether the kernel had to drop events for this client. When no"
        },
        {
          "line": 2734,
          "text": " *        events are dropped for this client, global_seq_num increments by 1 for"
        },
        {
          "line": 2735,
          "text": " *        every message. When events have been dropped, the difference between"
        },
        {
          "line": 2736,
          "text": " *        the last seen global sequence number and the global_seq_num of the"
        },
        {
          "line": 2737,
          "text": " *        received message indicates the number of events that had to be dropped."
        },
        {
          "line": 2738,
          "text": " *        Dropped events generally indicate that more events were generated in"
        },
        {
          "line": 2739,
          "text": " *        the kernel than the client was able to handle."
        },
        {
          "line": 2740,
          "text": " *        @see seq_num"
        },
        {
          "line": 2741,
          "text": " * @field opaque Opaque data that must not be accessed directly."
        },
        {
          "line": 2742,
          "text": " *"
        },
        {
          "line": 2743,
          "text": " * @note For events that can be authorized there are unique NOTIFY and AUTH"
        },
        {
          "line": 2744,
          "text": " * event types for the same event data, eg: event.exec is the correct union"
        },
        {
          "line": 2771,
          "text": "\tes_process_t *_Nonnull process;"
        },
        {
          "line": 2772,
          "text": "\tuint64_t seq_num; /* field available only if message version >= 2 */"
        },
        {
          "line": 2773,
          "text": "\tes_action_type_t action_type;"
        },
        {
          "line": 2774,
          "text": "\tunion {"
        },
        {
          "line": 2775,
          "text": "\t\tes_event_id_t auth;"
        },
        {
          "line": 2776,
          "text": "\t\tes_result_t notify;"
        },
        {
          "line": 2780,
          "text": "\tes_thread_t *_Nullable thread; /* field available only if message version >= 4 */"
        },
        {
