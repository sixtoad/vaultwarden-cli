        {
          "line": 6,
          "text": "/*"
        },
        {
          "line": 7,
          "text": " * This header is deprecated and may be removed in a future release."
        },
        {
          "line": 8,
          "text": " * Developers who wish to sandbox an app should instead adopt the App Sandbox"
        },
        {
          "line": 9,
          "text": " * feature described in the App Sandbox Design Guide."
        },
        {
          "line": 10,
          "text": " */"
        },
        {
          "line": 11,
          "text": ""
        },
        {
          "line": 12,
          "text": ""
        },
        {
          "line": 22,
          "text": ""
        },
        {
          "line": 23,
          "text": "/*"
        },
        {
          "line": 24,
          "text": " * @function sandbox_init"
        },
        {
          "line": 25,
          "text": " * Places the current process in a sandbox with a profile as"
        },
        {
          "line": 26,
          "text": " * specified.  If the process is already in a sandbox, the new profile"
        },
        {
          "line": 27,
          "text": " * is ignored and sandbox_init() returns an error."
        },
        {
          "line": 28,
          "text": " *"
        },
        {
          "line": 29,
          "text": " * @param profile (input)   The Sandbox profile to be used.  The format"
        },
        {
          "line": 30,
          "text": " * and meaning of this parameter is modified by the `flags' parameter."
        },
        {
          "line": 31,
          "text": " *"
        },
        {
          "line": 32,
          "text": " * @param flags (input)   Must be SANDBOX_NAMED.  All other"
        },
        {
          "line": 33,
          "text": " * values are reserved."
        },
        {
          "line": 34,
          "text": " *"
        },
        {
          "line": 35,
          "text": " * @param errorbuf (output)   In the event of an error, sandbox_init"
        },
        {
          "line": 36,
          "text": " * will set `*errorbuf' to a pointer to a NUL-terminated string"
        },
        {
          "line": 37,
          "text": " * describing the error. This string may contain embedded newlines."
        },
        {
          "line": 38,
          "text": " * This error information is suitable for developers and is not"
        },
        {
          "line": 39,
          "text": " * intended for end users."
        },
        {
          "line": 40,
          "text": " *"
        },
        {
          "line": 44,
          "text": " * @result 0 on success, -1 otherwise."
        },
        {
          "line": 45,
          "text": " */"
        },
        {
          "line": 46,
          "text": "API_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))"
        },
        {
          "line": 47,
          "text": "API_UNAVAILABLE(macCatalyst)"
        },
        {
          "line": 48,
          "text": "OS_WARN_RESULT"
        },
        {
          "line": 49,
          "text": "int sandbox_init(const char *profile, uint64_t flags, char **errorbuf);"
        },
        {
          "line": 50,
          "text": ""
        },
        {
          "line": 51,
          "text": "/*"
        },
        {
          "line": 52,
          "text": " * @define SANDBOX_NAMED  The `profile' argument specifies a Sandbox"
        },
        {
          "line": 53,
          "text": " * profile named by one of the kSBXProfile* string constants."
        },
        {
          "line": 54,
          "text": " */"
        },
        {
          "line": 57,
          "text": "/*"
        },
        {
          "line": 58,
          "text": " * @function sandbox_free_error"
        },
        {
          "line": 59,
          "text": " * Deallocates an error string previously allocated by sandbox_init."
        },
        {
          "line": 60,
          "text": " *"
        },
        {
          "line": 61,
          "text": " * @param errorbuf (input)   The buffer to be freed.  Must be a pointer"
        },
        {
          "line": 62,
          "text": " * previously returned by sandbox_init in the `errorbuf' argument, or NULL."
        },
        {
          "line": 63,
          "text": " *"
        },
        {
          "line": 64,
          "text": " * @result void"
        },
        {
          "line": 65,
          "text": " */"
        },
        {
          "line": 66,
          "text": "API_DEPRECATED(\"No longer supported\", macos(10.5, 10.8), ios(2.0, 6.0), tvos(4.0, 4.0), watchos(1.0, 1.0))"
        },
        {
          "line": 67,
          "text": "API_UNAVAILABLE(macCatalyst)"
        },
        {
          "line": 68,
          "text": "void sandbox_free_error(char *errorbuf);"
        },
        {
          "line": 69,
          "text": ""
        },
        {
          "line": 70,
          "text": "__END_DECLS"
        },
        {
          "line": 71,
          "text": ""
        }
