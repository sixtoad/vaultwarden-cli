[Unit]
Description=Vaultwarden Access protected execution provider

[Service]
Type=exec
ExecStart=%h/.local/bin/vaultwarden-accessd --state-root %h/.local/share/vaultwarden-access/provider
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30s
LimitCORE=0
NoNewPrivileges=yes

# Protected delivery helpers run in separate user-manager units. Those units
# must not depend on this provider's lifetime or terminate consumers on access
# cancellation. The KillMode above applies only to the provider's own processes.

[Install]
WantedBy=default.target
