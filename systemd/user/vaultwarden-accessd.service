[Unit]
Description=Vaultwarden Access protected execution provider

[Service]
Type=exec
ExecStart=%h/.local/bin/vaultwarden-accessd --state-root %h/.local/share/vaultwarden-access/provider
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30s
LimitCORE=0
NoNewPrivileges=yes

# Protected request units are created by the systemd user manager, not
# by agent clients or this service directly. Each must be manager-owned and
# bind to this unit with BindsTo=, PartOf= and After= plus KillMode=control-group.

[Install]
WantedBy=default.target
